---
import { Image } from 'astro:assets';
import { examplePath, type Example } from '../lib/examples';

interface Props {
  example: Example;
}

const { example } = Astro.props;
const { data } = example;
---

<a class="card" href={examplePath(example)}>
  <div class="card__media">
    <Image
      src={data.hero}
      alt={`${data.name} in ${data.location}`}
      widths={[400, 720, 1080]}
      sizes="(min-width: 760px) 50vw, 100vw"
      quality={75}
    />
  </div>
  <div class="card__body">
    {data.featured && <span class="badge">Featured</span>}
    <h3>{data.name}</h3>
    <p class="card__meta">{data.location}</p>
    <p class="card__hook">{data.hook}</p>
  </div>
</a>
