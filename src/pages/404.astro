---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That page is not in the Greendominium catalog.">
  <div class="wrap page-head">
    <p class="eyebrow">404</p>
    <h1>Nothing planted here.</h1>
    <p class="lede">That URL is not in the catalog. The examples gallery is a good place to turn around.</p>
    <div class="actions">
      <a class="btn btn--primary" href="/examples">Examples</a>
      <a class="btn btn--ghost" href="/">Home</a>
    </div>
  </div>
</BaseLayout>
